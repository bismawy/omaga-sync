#!/usr/bin/env python3
"""Omaga Sync login helper.

Bridges the real terminal to an interactive `mega-cmd` session running on a
pty, with `login <email>` pre-fed. Password and 2FA prompts are read by
mega-cmd from the pty directly, so input stays hidden and nothing races the
keyboard. Exits when mega-cmd exits (quit or window close).
"""
import fcntl
import os
import pty
import select
import sys
import termios
import time
import tty


def main():
    email = sys.argv[1] if len(sys.argv) > 1 else ""

    master, slave = pty.openpty()
    try:
        winsz = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(slave, termios.TIOCSWINSZ, winsz)
    except Exception:
        pass

    pid = os.fork()
    if pid == 0:
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        os.dup2(slave, 0)
        os.dup2(slave, 1)
        os.dup2(slave, 2)
        if slave > 2:
            os.close(slave)
        os.close(master)
        os.execvp("mega-cmd", ["mega-cmd"])
        os._exit(127)

    os.close(slave)
    attrs = termios.tcgetattr(0)
    tty.setraw(0)

    fed = False
    status = 0
    try:
        while True:
            r, _, _ = select.select([0, master], [], [])
            if 0 in r:
                data = os.read(0, 4096)
                if not data:
                    break
                os.write(master, data)
            if master in r:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    break
                if not data:
                    break
                os.write(1, data)
                if not fed and b"MEGA CMD>" in data:
                    time.sleep(0.1)
                    os.write(master, ("login " + email + "\n").encode())
                    fed = True
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, attrs)
        try:
            os.close(master)
        except OSError:
            pass
        try:
            _, status = os.waitpid(pid, 0)
        except ChildProcessError:
            pass
    sys.exit(os.waitstatus_to_exitcode(status))


if __name__ == "__main__":
    main()
