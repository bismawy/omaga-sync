#!/usr/bin/env python3
"""Omaga Sync — MEGA two-way sync monitor & control for Omarchy.

Engine: official MEGAcmd server (mega-cmd-server), supervised by systemd
as omaga-sync-engine.service. This script keeps the derived status file
fresh and exposes small control commands for the bar widget.

Subcommands:
  monitor        poll loop; writes ~/.local/state/omaga-sync/status.json
  status         print the current status file
  pause          stop the sync engine (all pairs)
  resume         start the sync engine
  open <path>    open a local folder with xdg-open

States written to status.json:
  starting  engine just booted, MEGAcmd not answering yet
  auth      MEGA session missing/expired — needs `mega-login`
  offline   engine running but MEGAcmd unreachable past the grace window
  paused    engine service stopped by the user
  error     at least one sync pair is in a failed state
  syncing   at least one pair is transferring
  synced    all pairs idle and up to date
"""

import json
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/omaga-sync"
STATUS_PATH = STATE_DIR / "status.json"

ENGINE_UNIT = "omaga-sync-engine.service"
POLL_SECONDS = 5.0
# mega-* clients auto-spawn an unsupervised server when the socket is absent,
# so never touch them while the systemd unit is down.
OFFLINE_GRACE_SECONDS = 30
STARTING_GRACE_SECONDS = 45
WHOAMI_EVERY_TICKS = 12  # ~60s between account/quota refreshes
NOTIFY_DEDUPE_SECONDS = 600

SYNC_FAILED_MARKERS = ("FAIL", "ERROR", "DISABLED")
SYNC_ACTIVE_MARKERS = ("SYNCING", "INITIALIZING", "PENDING", "SCANNING")

UNIT_SPEC = {
    "B": 1, "KB": 2**10, "MB": 2**20, "GB": 2**30, "TB": 2**40, "PB": 2**50,
}


def log(msg):
    print(f"omaga-sync: {msg}", flush=True)


def sh(args, timeout=8):
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, proc.stdout or "", proc.stderr or ""
    except FileNotFoundError:
        return 127, "", f"command not found: {args[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def engine_active():
    rc, out, _ = sh(["systemctl", "--user", "is-active", ENGINE_UNIT], timeout=4)
    return rc == 0 and out.strip() == "active"


def parse_whoami(out):
    """Extract email and storage usage from `mega-whoami` text output."""
    info = {"email": "", "used_bytes": 0, "total_bytes": 0}
    email = re.search(r"e-?mail\s*:\s*(\S+@\S+)", out, re.IGNORECASE)
    if email:
        info["email"] = email.group(1).strip("<>")
    sizes = re.findall(
        r"([\d.]+)\s*(B|KB|MB|GB|TB|PB)\s*(?:of|/)\s*([\d.]+)\s*(B|KB|MB|GB|TB|PB)",
        out, re.IGNORECASE)
    if sizes:
        used, u_unit, total, t_unit = sizes[-1]
        info["used_bytes"] = int(float(used) * UNIT_SPEC[u_unit.upper()])
        info["total_bytes"] = int(float(total) * UNIT_SPEC[t_unit.upper()])
    return info


def parse_pairs(out):
    """Parse `mega-sync` listing into pair dicts. Tolerant by design:
    the documented table uses | separators; fall back to whitespace split."""
    pairs = []
    for line in out.splitlines():
        line = line.strip()
        if not line or set(line) <= {"=", "-", "|", " "}:
            continue
        if "|" in line:
            cells = [c.strip() for c in line.split("|")]
        else:
            cells = line.split()
        if len(cells) < 3:
            continue
        # Drop a leading row index if present ("1", "2", ...).
        if cells[0].isdigit() and len(cells) >= 4:
            cells = cells[1:]
        local, remote, state = cells[0], cells[1], cells[-1].upper()
        if not local.startswith("/") and not local.startswith("~"):
            continue  # header row or unknown layout
        pairs.append({"local": local, "remote": remote, "state": state})
    return pairs


def notify(summary, body=""):
    args = ["notify-send", "-a", "Omaga Sync", "-t", "6000", summary]
    if body:
        args.append(body)
    sh(args, timeout=4)


class Monitor:
    def __init__(self):
        self.account = {"email": "", "used_bytes": 0, "total_bytes": 0}
        self.whoami_tick = WHOAMI_EVERY_TICKS  # refresh on first loop
        self.engine_started_at = time.monotonic()
        self.first_offline_at = None
        self.last_state = None
        self.last_notify_at = 0.0
        self.last_notify_key = ""

    # -- polling ---------------------------------------------------------
    def read_once(self):
        if not engine_active():
            self.first_offline_at = None
            return {"state": "paused"}

        rc, out, err = sh(["mega-whoami"], timeout=8)
        now = time.monotonic()
        reachable = rc == 0 or "not logged in" in (out + err).lower() or "log in" in (out + err).lower()
        if not reachable:
            if self.first_offline_at is None:
                self.first_offline_at = now
            elapsed = now - self.first_offline_at
            if elapsed < OFFLINE_GRACE_SECONDS or now - self.engine_started_at < STARTING_GRACE_SECONDS:
                return {"state": "starting"}
            return {"state": "offline"}
        self.first_offline_at = None

        logged_out = "not logged in" in (out + err).lower() or "log in" in (out + err).lower()
        if logged_out:
            return {"state": "auth"}

        if self.whoami_tick >= WHOAMI_EVERY_TICKS:
            self.whoami_tick = 0
            self.account = parse_whoami(out)
        self.whoami_tick += 1

        _, sync_out, _ = sh(["mega-sync"], timeout=8)
        pairs = parse_pairs(sync_out)
        states = [p["state"] for p in pairs]
        if any(any(m in s for m in SYNC_FAILED_MARKERS) for s in states):
            state = "error"
        elif any(any(m in s for m in SYNC_ACTIVE_MARKERS) for s in states):
            state = "syncing"
        else:
            state = "synced"
        return {"state": state, "pairs": pairs}

    # -- notifications ---------------------------------------------------
    def maybe_notify(self, status):
        state = status.get("state", "")
        if state not in ("error", "offline", "auth"):
            self.last_state = state
            return
        if state == self.last_state:
            return  # still inside the same episode; stay quiet
        self.last_state = state

        now = time.monotonic()
        key = f"{state}:{status.get('message', '')}"
        if now - self.last_notify_at < NOTIFY_DEDUPE_SECONDS and key == self.last_notify_key:
            return
        self.last_notify_at = now
        self.last_notify_key = key

        if state == "auth":
            notify("MEGA Sync: perlu login", "Jalankan `mega-login email-anda` di terminal.")
        elif state == "offline":
            notify("MEGA Sync: server tidak terjangkau", "Periksa koneksi atau jalankan `journalctl --user -u omaga-sync-engine`.")  # noqa: E501
        else:
            failed = [p for p in status.get("pairs", [])
                      if any(m in p.get("state", "") for m in SYNC_FAILED_MARKERS)]
            detail = "; ".join(f"{p['local']}: {p['state']}" for p in failed) or "lihat panel untuk detail"
            notify("MEGA Sync: sinkronisasi gagal", detail)

    # -- loop --------------------------------------------------------------
    def write_status(self, partial):
        status = {
            "state": partial.get("state", "unknown"),
            "updatedTs": int(time.time()),
            "email": self.account.get("email", "") if partial.get("state") not in ("paused", "auth") else "",
            "usedBytes": self.account.get("used_bytes", 0) if partial.get("state") not in ("paused", "auth") else 0,
            "totalBytes": self.account.get("total_bytes", 0) if partial.get("state") not in ("paused", "auth") else 0,
            "pairs": partial.get("pairs", []),
            "message": partial.get("message", ""),
        }
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = tempfile.NamedTemporaryFile(
            "w", dir=STATE_DIR, prefix=".status.", suffix=".json", delete=False)
        try:
            json.dump(status, tmp, ensure_ascii=False)
            tmp.close()
            STATUS_PATH.replace(tmp.name)  # atomic on the same filesystem
        finally:
            if not tmp.closed:
                tmp.close()
        return status

    def run(self):
        log("monitor started")
        while True:
            try:
                if engine_active() and self.last_state in (None, "paused"):
                    self.engine_started_at = time.monotonic()
                partial = self.read_once()
                status = self.write_status(partial)
                self.maybe_notify(status)
            except Exception as exc:  # never die on one bad tick
                log(f"tick error: {exc}")
            time.sleep(POLL_SECONDS)


def cmd_status():
    try:
        print(STATUS_PATH.read_text(), end="")
        return 0
    except FileNotFoundError:
        print("status file belum ada; monitor belum berjalan", file=sys.stderr)
        return 1


def cmd_pause():
    rc, _, err = sh(["systemctl", "--user", "stop", ENGINE_UNIT])
    if rc != 0:
        log(f"gagal stop engine: {err.strip()}")
    return rc


def cmd_resume():
    rc, _, err = sh(["systemctl", "--user", "start", ENGINE_UNIT])
    if rc != 0:
        log(f"gagal start engine: {err.strip()}")
    return rc


def cmd_open(path):
    if not path or not Path(path).expanduser().is_dir():
        log(f"folder tidak ditemukan: {path}")
        return 1
    return sh(["xdg-open", str(Path(path).expanduser())])[0]


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("monitor",):
        Monitor().run()
    elif sys.argv[1] == "status":
        return cmd_status()
    elif sys.argv[1] == "pause":
        return cmd_pause()
    elif sys.argv[1] == "resume":
        return cmd_resume()
    elif sys.argv[1] == "open":
        return cmd_open(sys.argv[2] if len(sys.argv) > 2 else "")
    elif sys.argv[1] == "once":  # one poll — for smoke testing
        m = Monitor()
        status = m.write_status(m.read_once())
        print(json.dumps(status, ensure_ascii=False, indent=2))
        return 0
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
