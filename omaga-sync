#!/usr/bin/env python3
"""Omaga Sync — MEGA two-way sync monitor & control for Omarchy.

Engine: MEGAcmd server (mega-cmd-server), supervised by systemd
as omaga-sync-engine.service. This script keeps the derived status file
fresh and exposes small control commands for the bar widget.

Subcommands:
  monitor          poll loop; writes ~/.local/state/omaga-sync/status.json
  status           print the current status file (bounded read, max 64 KB)
  pause [path]     pause one sync pair, or all when no path is given
  resume [path]    resume one sync pair, or all when no path is given
  repair           kill an unsupervised server and restart it under systemd
  login [email]    open a terminal with the interactive mega-login prompt
  open <path>      open a local folder with xdg-open

States written to status.json:
  starting  engine just booted, not answering yet
  auth      MEGA session missing/expired — needs `mega-login`
  offline   engine unit not coming up
  paused    every sync pair is suspended
  error     a pair failed, or the server escaped systemd supervision
  syncing   at least one pair is transferring/loading
  synced    all pairs idle and up to date
"""

import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio as _Gio
except Exception:  # python-gobject absent — fall back to the `gio` CLI
    _Gio = None

STATE_DIR = Path.home() / ".local/state/omaga-sync"
STATUS_PATH = STATE_DIR / "status.json"

ENGINE_UNIT = "omaga-sync-engine.service"
POLL_SECONDS = 5.0
# mega-* clients auto-spawn an unsupervised server when the socket is absent,
# so never call them without checking the systemd unit first.
STARTING_TICKS_LIMIT = 9  # ~45s before "starting" becomes "offline"
WHOAMI_EVERY_TICKS = 12  # ~60s between account/quota refreshes
NOTIFY_DEDUPE_SECONDS = 600

RUN_STATES = {"PENDING", "LOADING", "RUNNING", "SUSPENDED", "DISABLED"}
STATUS_VALUES = {"NONE", "SYNCED", "PENDING", "SYNCING", "PROCESSING", "ERROR"}
SYNC_LIST_ARGS = ["mega-sync", "--col-separator=|",
                  "--output-cols=LOCALPATH,REMOTEPATH,RUN_STATE,STATUS,ERROR"]

MAX_PROC_OUTPUT = 256 * 1024  # 256 KB max command output
MAX_PAIRS = 50
MAX_REMOTE_FOLDERS = 100
MAX_TRANSFERS = 6

# Nautilus folder badges (metadata::emblems) mirroring pair states.
PAIR_EMBLEMS = {
    "syncing": "emblem-omaga-syncing",
    "synced": "emblem-omaga-synced",
    "paused": "emblem-omaga-paused",
    "error": "emblem-omaga-error",
}
EMBLEM_TRANSFER = "emblem-omaga-transfer"
EMBLEM_WALK_EVERY_TICKS = 6  # full tree re-walk interval (~30s)
MAX_EMBLEM_PATHS = 60000  # ponytail: raise if giant trees need full coverage
MAX_STR_LEN = 256
MAX_STATUS_JSON_BYTES = 64 * 1024


def log(msg):
    print(f"omaga-sync: {msg}", flush=True)


def sh(args, timeout=8):
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        out = (proc.stdout or "")[:MAX_PROC_OUTPUT]
        err = (proc.stderr or "")[:MAX_PROC_OUTPUT]
        return proc.returncode, out, err
    except FileNotFoundError:
        return 127, "", f"command not found: {args[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def engine_active():
    rc, out, _ = sh(["systemctl", "--user", "is-active", ENGINE_UNIT], timeout=4)
    return rc == 0 and out.strip() == "active"


def server_process_running():
    rc, _, _ = sh(["pgrep", "-u", str(os.getuid()), "-x", "mega-cmd-server"], timeout=4)
    return rc == 0


def parse_transfers_summary(out):
    """Extract transfer counts and totals from `mega-transfers --summary`."""
    summary = {
        "downloadsCount": 0, "downloaded": "0 B", "downloadTotal": "0 B", "downloadPercent": 0.0,
        "uploadsCount": 0, "uploaded": "0 B", "uploadTotal": "0 B", "uploadPercent": 0.0,
    }
    m = re.findall(r"(\d+)\s+([\d.]+\s+[A-Za-z]+)\s+([\d.]+\s+[A-Za-z]+)\s+([\d.]+)%", out)
    if len(m) >= 2:
        summary["downloadsCount"] = int(m[0][0])
        summary["downloaded"] = m[0][1].strip()
        summary["downloadTotal"] = m[0][2].strip()
        summary["downloadPercent"] = float(m[0][3])
        summary["uploadsCount"] = int(m[1][0])
        summary["uploaded"] = m[1][1].strip()
        summary["uploadTotal"] = m[1][2].strip()
        summary["uploadPercent"] = float(m[1][3])
    return summary


def parse_sync_issue_paths(out):
    """Extract local paths from `mega-sync-issues` (PARENT_SYNC + quoted name)."""
    paths = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3 or not parts[1].startswith("/"):
            continue
        m = re.search(r"'([^']+)'", parts[2])
        if m:
            paths.append(parts[1].rstrip("/") + "/" + m.group(1))
    return paths[:16]


def parse_active_transfers(out):
    """Extract individual ongoing transfer rows from `mega-transfers --show-syncs`."""
    transfers = []
    for line in out.splitlines():
        if len(transfers) >= MAX_TRANSFERS:
            break
        line = line.strip()
        if not line or "|" not in line or line.startswith("TYPE"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) >= 6:
            ttype, tag, src, dst, prog, state = parts[0], parts[1], parts[2], parts[3], parts[4], parts[5]
            filename = src.rsplit("/", 1)[-1] if "/" in src else src
            direction = "upload" if "⇑" in ttype else "download"
            transfers.append({
                "type": direction,
                "file": filename[:64],
                "path": src[:MAX_STR_LEN],
                "dest": dst[:MAX_STR_LEN],
                "progress": prog[:48],
                "state": state.lower()[:32],
            })
    return transfers


def parse_whoami(out):
    """Extract email (storage quota comes from mega-df instead)."""
    info = {"email": "", "used_bytes": 0, "total_bytes": 0}
    email = re.search(r"e-?mail\s*:\s*<?([^\s<>]+@[^\s<>]+)", out, re.IGNORECASE)
    if email:
        info["email"] = email.group(1)[:MAX_STR_LEN]
    return info


def parse_df(out):
    """USED STORAGE line from `mega-df`: used bytes and total bytes."""
    m = re.search(r"USED STORAGE:\s+(\d+)\s+[\d.]+%\s*of\s+(\d+)", out)
    if m:
        return int(m.group(1)), int(m.group(2))
    return 0, 0


def parse_remote_folders(out):
    """`mega-ls /` output: one entry per line, optionally prefixed with a
    decorative emoji/icon. Folder names may contain spaces."""
    names = []
    for line in out.splitlines():
        if len(names) >= MAX_REMOTE_FOLDERS:
            break
        line = line.strip()
        if not line or line.startswith("["):
            continue
        name = re.sub(r"^[^\w]+", "", line).strip()[:MAX_STR_LEN]
        if name and name not in names:
            names.append(name)
    return names


def normalize_pair(run, status):
    if status == "ERROR":
        return "error"
    if run in ("SUSPENDED", "DISABLED"):
        return "paused"
    if run in ("PENDING", "LOADING") or status in ("SYNCING", "PENDING", "PROCESSING"):
        return "syncing"
    if status == "SYNCED" and run == "RUNNING":
        return "synced"
    return "syncing"  # unknown combinations read as active, never as idle


def parse_pairs(out):
    """Parse `mega-sync` listing into pair dicts. Handles both the
    --output-cols format (always requested) and the legacy table; log lines
    from the client are skipped."""
    pairs = []
    for line in out.splitlines():
        if len(pairs) >= MAX_PAIRS:
            break
        line = line.strip()
        if not line or line.startswith("["):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0].isdigit():  # legacy table row index
            cells = cells[1:]
        if len(cells) < 2 or cells[0][:1] not in ("/", "~"):
            continue
        local, remote = cells[0][:MAX_STR_LEN], cells[1][:MAX_STR_LEN]
        run = status = ""
        words = []
        for cell in cells[2:]:
            upper = cell.upper()
            if upper in RUN_STATES:
                run = upper
            elif upper in STATUS_VALUES:
                status = upper
            elif cell and upper not in ("NO", "NONE", "NO_ERROR", "NO ERROR", "-"):
                words.append(cell)
        pairs.append({
            "local": local,
            "remote": remote,
            "run": run,
            "status": status,
            "state": normalize_pair(run, status),
            "error": " ".join(words)[:200],
        })
    return pairs


def notify(summary, body=""):
    args = ["notify-send", "-a", "Omaga Sync", "-t", "6000", summary]
    if body:
        args.append(body)
    sh(args, timeout=4)


class Monitor:
    def __init__(self):
        self.account = {"email": "", "used_bytes": 0, "total_bytes": 0}
        self.remote_folders = []
        self.whoami_tick = WHOAMI_EVERY_TICKS  # refresh on first loop
        self.starting_ticks = 0
        self.last_state = None
        self.last_notify_at = 0.0
        self.last_notify_key = ""
        self.batch_total_downloads = 0
        self.batch_total_uploads = 0
        self.emblems = {}  # local path -> emblem currently set
        self.emblem_paths = set()  # every badged path under active pair roots
        self.emblem_roots = []
        self.emblem_tick = -1  # force first walk

    # -- folder emblems (Nautilus) -----------------------------------------
    def sync_emblems(self, status):
        """Mirror sync states onto folder and file icons in GNOME Files.

        Badges every subfolder and file under each active pair root
        (synced / syncing / error), plus files currently transferring.
        Nautilus renders metadata::emblems as corner badges; writes are
        diffed per tick so idle ticks cost nothing.
        """
        wanted = self.emblem_targets(status)
        for path, emblem in wanted.items():
            if self.emblems.get(path) == emblem:
                continue
            if self.set_emblem(path, emblem):
                self.emblems[path] = emblem
        for path in list(self.emblems):
            if path not in wanted:
                if self.set_emblem(path, None):
                    del self.emblems[path]

    @staticmethod
    def set_emblem(path, emblem):
        """Set (or clear, emblem=None) metadata::emblems on one path."""
        if _Gio is not None:
            f = _Gio.File.new_for_path(path)
            if emblem is None:
                return bool(f.set_attribute(
                    "metadata::emblems", _Gio.FileAttributeType.INVALID, None,
                    _Gio.FileQueryInfoFlags.NONE, None))
            info = _Gio.FileInfo.new()
            info.set_attribute_stringv("metadata::emblems", [emblem])
            res = f.set_attributes_from_info(
                info, _Gio.FileQueryInfoFlags.NONE, None)
            return bool(res[0] if isinstance(res, tuple) else res)
        cmd = ["gio", "set", "-t", "unset" if emblem is None else "stringv",
               path, "metadata::emblems"]
        if emblem is not None:
            cmd.append(emblem)
        return sh(cmd, timeout=5)[0] == 0

    def refresh_emblem_walk(self, roots):
        paths = set()
        for root in roots:
            for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
                dirnames[:] = [d for d in dirnames if not d.startswith(".")]
                for name in filenames:
                    if not name.startswith("."):
                        paths.add(os.path.join(dirpath, name))
                for d in dirnames:
                    paths.add(os.path.join(dirpath, d))
                if len(paths) >= MAX_EMBLEM_PATHS:
                    break
        self.emblem_paths = paths

    @staticmethod
    def nearest_badged_parent(path, wanted):
        parent = path
        while True:
            parent = parent.rsplit("/", 1)[0]
            if parent in wanted:
                return parent
            if parent in ("", "/"):
                return ""

    def emblem_targets(self, status):
        pairs = status.get("pairs") or []
        roots = {str(p.get("local") or ""): p.get("state")
                 for p in pairs if p.get("local")}
        walk_roots = sorted(r for r, s in roots.items() if s in ("synced", "syncing"))
        self.emblem_tick += 1
        if self.emblem_tick >= EMBLEM_WALK_EVERY_TICKS or walk_roots != self.emblem_roots:
            self.refresh_emblem_walk(walk_roots)
            self.emblem_roots = walk_roots
            self.emblem_tick = 0
        wanted = {p: PAIR_EMBLEMS["synced"] for p in self.emblem_paths}
        for root, state in roots.items():
            emblem = PAIR_EMBLEMS.get(state)
            if emblem:
                wanted[root] = emblem
        # active transfer flips its nearest folder (and the file) to syncing
        for tr in status.get("activeTransfers") or []:
            local = str(tr.get("dest") or "") if tr.get("type") == "download" \
                else str(tr.get("path") or "")
            if not local:
                continue
            folder = self.nearest_badged_parent(local, wanted)
            if folder:
                wanted[folder] = PAIR_EMBLEMS["syncing"]
            wanted[local] = EMBLEM_TRANSFER
        # sync issues (e.g. symlinks) flag their containing folder as error
        if any(s in ("syncing", "error") for s in roots.values()):
            _, issues_out, _ = sh(["mega-sync-issues"], timeout=5)
            for path in parse_sync_issue_paths(issues_out):
                folder = self.nearest_badged_parent(path, wanted)
                if folder:
                    wanted[folder] = PAIR_EMBLEMS["error"]
        return wanted

    # -- polling -----------------------------------------------------------
    def read_once(self):
        if not engine_active():
            self.starting_ticks += 1
            if server_process_running():
                # A client auto-spawned a server outside systemd; it would
                # keep the socket so the supervised unit can never bind.
                return {"state": "error",
                        "message": "server di luar systemd — jalankan: omaga-sync repair"}
            if self.starting_ticks == 1:
                sh(["systemctl", "--user", "start", ENGINE_UNIT], timeout=8)
            if self.starting_ticks > STARTING_TICKS_LIMIT:
                return {"state": "offline"}
            return {"state": "starting"}

        self.starting_ticks = 0
        rc, out, err = sh(["mega-whoami"], timeout=10)
        combined = (out + err).lower()
        if "not logged in" in combined:
            return {"state": "auth"}
        if rc != 0:
            return {"state": "starting"}  # booting or briefly unreachable

        if self.whoami_tick >= WHOAMI_EVERY_TICKS:
            self.whoami_tick = 0
            self.account = parse_whoami(out)
            _, df_out, _ = sh(["mega-df"], timeout=10)
            used, total = parse_df(df_out)
            if total > 0:
                self.account["used_bytes"] = used
                self.account["total_bytes"] = total
            _, ls_out, _ = sh(["mega-ls", "/"], timeout=10)
            self.remote_folders = parse_remote_folders(ls_out)
        self.whoami_tick += 1

        _, sync_out, _ = sh(SYNC_LIST_ARGS, timeout=10)
        pairs = parse_pairs(sync_out)
        states = [p["state"] for p in pairs]

        active_transfers = []
        transfers_summary = None

        if any(s == "syncing" for s in states):
            _, t_sum_out, _ = sh(["mega-transfers", "--summary"], timeout=5)
            transfers_summary = parse_transfers_summary(t_sum_out)
            dl_cnt = transfers_summary["downloadsCount"]
            ul_cnt = transfers_summary["uploadsCount"]

            if dl_cnt > 0:
                if dl_cnt > self.batch_total_downloads:
                    self.batch_total_downloads = dl_cnt
                transfers_summary["downloadsTotalCount"] = self.batch_total_downloads
                transfers_summary["downloadsCompletedCount"] = max(0, self.batch_total_downloads - dl_cnt)
            else:
                self.batch_total_downloads = 0
                transfers_summary["downloadsTotalCount"] = 0
                transfers_summary["downloadsCompletedCount"] = 0

            if ul_cnt > 0:
                if ul_cnt > self.batch_total_uploads:
                    self.batch_total_uploads = ul_cnt
                transfers_summary["uploadsTotalCount"] = self.batch_total_uploads
                transfers_summary["uploadsCompletedCount"] = max(0, self.batch_total_uploads - ul_cnt)
            else:
                self.batch_total_uploads = 0
                transfers_summary["uploadsTotalCount"] = 0
                transfers_summary["uploadsCompletedCount"] = 0

            if dl_cnt > 0 or ul_cnt > 0:
                _, t_act_out, _ = sh(["mega-transfers", "--show-syncs", "--col-separator=|",
                                      f"--limit={MAX_TRANSFERS}"], timeout=5)
                active_transfers = parse_active_transfers(t_act_out)
        else:
            self.batch_total_downloads = 0
            self.batch_total_uploads = 0

        if any(s == "error" for s in states):
            return {"state": "error", "pairs": pairs,
                    "transfersSummary": transfers_summary, "activeTransfers": active_transfers,
                    "message": "; ".join(p["error"] for p in pairs if p["error"])[:200]}
        if pairs and all(s == "paused" for s in states):
            return {"state": "paused", "pairs": pairs}
        if any(s != "synced" for s in states):
            return {"state": "syncing", "pairs": pairs,
                    "transfersSummary": transfers_summary, "activeTransfers": active_transfers}
        return {"state": "synced", "pairs": pairs}

    # -- notifications -------------------------------------------------------
    def maybe_notify(self, status):
        state = status.get("state", "")
        if state not in ("error", "offline", "auth"):
            self.last_state = state
            return
        if state == self.last_state:
            return  # same episode; stay quiet
        self.last_state = state

        now = time.monotonic()
        key = f"{state}:{status.get('message', '')}"
        if now - self.last_notify_at < NOTIFY_DEDUPE_SECONDS and key == self.last_notify_key:
            return
        self.last_notify_at = now
        self.last_notify_key = key

        if state == "auth":
            notify("MEGA Sync: perlu login", "Jalankan `mega-login email-anda` di terminal.")
        elif state == "offline":
            notify("MEGA Sync: mesin tidak menyala",
                   "Periksa: journalctl --user -u omaga-sync-engine")
        else:
            detail = status.get("message") or "lihat panel untuk detail"
            notify("MEGA Sync: sinkronisasi bermasalah", detail)

    # -- status file ---------------------------------------------------------
    def write_status(self, partial):
        healthy = partial.get("state") not in ("paused", "auth")
        pairs = partial.get("pairs", [])[:MAX_PAIRS]
        folders = self.remote_folders[:MAX_REMOTE_FOLDERS] if partial.get("state") != "auth" else []
        status = {
            "state": str(partial.get("state", "unknown"))[:32],
            "updatedTs": int(time.time()),
            "email": str(self.account.get("email", ""))[:MAX_STR_LEN] if healthy else "",
            "usedBytes": int(self.account.get("used_bytes", 0)) if healthy else 0,
            "totalBytes": int(self.account.get("total_bytes", 0)) if healthy else 0,
            "pairs": pairs,
            "remoteFolders": folders,
            "transfersSummary": partial.get("transfersSummary"),
            "activeTransfers": partial.get("activeTransfers", [])[:MAX_TRANSFERS],
            "message": str(partial.get("message", ""))[:MAX_STR_LEN],
        }
        raw_json = json.dumps(status, ensure_ascii=False)
        if len(raw_json.encode("utf-8")) > MAX_STATUS_JSON_BYTES:
            status["remoteFolders"] = []
            status["pairs"] = pairs[:10]
            status["activeTransfers"] = status.get("activeTransfers", [])[:3]
            raw_json = json.dumps(status, ensure_ascii=False)

        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = tempfile.NamedTemporaryFile(
            "w", dir=STATE_DIR, prefix=".status.", suffix=".json", delete=False)
        try:
            tmp.write(raw_json)
            tmp.close()
            Path(tmp.name).replace(STATUS_PATH)  # atomic on the same filesystem
        except BaseException:
            Path(tmp.name).unlink(missing_ok=True)
            raise
        finally:
            if not tmp.closed:
                tmp.close()
        return status

    def run(self):
        log("monitor started")
        while True:
            try:
                status = self.write_status(self.read_once())
                self.sync_emblems(status)
                self.maybe_notify(status)
            except Exception as exc:  # never die on one bad tick
                log(f"tick error: {exc}")
            time.sleep(POLL_SECONDS)


# -- control commands --------------------------------------------------------
def ensure_engine():
    if not engine_active():
        sh(["systemctl", "--user", "start", ENGINE_UNIT], timeout=8)
        for _ in range(4):
            if engine_active():
                return True
            time.sleep(1)
    return engine_active()


def pair_paths():
    _, out, _ = sh(SYNC_LIST_ARGS, timeout=10)
    return [p["local"] for p in parse_pairs(out) if p["state"] != "paused"]


def cmd_pause(path=""):
    if path:
        rc = sh(["mega-sync", "--pause", path], timeout=10)[0]
    elif not ensure_engine():
        return 1
    else:
        rc = 0
        for local in pair_paths():
            rc |= sh(["mega-sync", "--pause", local], timeout=10)[0]
    if rc == 0:
        refresh_status_now()
    return rc


def cmd_resume(path=""):
    if path:
        rc = sh(["mega-sync", "--enable", path], timeout=10)[0]
    elif not ensure_engine():
        return 1
    else:
        rc = 0
        _, out, _ = sh(SYNC_LIST_ARGS, timeout=10)
        for pair in parse_pairs(out):
            rc |= sh(["mega-sync", "--enable", pair["local"]], timeout=10)[0]
    if rc == 0:
        refresh_status_now()
    return rc


def cmd_repair():
    sh(["pkill", "-u", str(os.getuid()), "-x", "mega-cmd-server"], timeout=4)
    time.sleep(1)
    rc = sh(["systemctl", "--user", "restart", ENGINE_UNIT], timeout=8)[0]
    log("repair selesai" if rc == 0 else "repair gagal; cek journalctl")
    return rc


def read_status_bounded():
    """Bounded, no-follow read of status.json for external consumers.

    Opens with O_NOFOLLOW and fstats the open fd, so the type/size check
    can't be raced by a swap between check and read. Returns at most
    MAX_STATUS_JSON_BYTES of text, or None when the file is missing,
    a symlink, not a regular file, or oversized."""
    try:
        fd = os.open(STATUS_PATH, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None
        if st.st_size > MAX_STATUS_JSON_BYTES:
            return None
        chunks = []
        total = 0
        while total <= MAX_STATUS_JSON_BYTES:
            chunk = os.read(fd, MAX_STATUS_JSON_BYTES + 1 - total)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
    finally:
        os.close(fd)
    if total > MAX_STATUS_JSON_BYTES:
        return None
    return b"".join(chunks).decode("utf-8", errors="replace")


def cmd_status():
    data = read_status_bounded()
    if data is None:
        print("status file tidak tersedia, bukan file biasa, atau melebihi batas ukuran",
              file=sys.stderr)
        return 1
    print(data, end="")
    return 0


def is_safe_user_path(p: Path) -> bool:
    """Verify path is under user's home directory and not a symlink."""
    try:
        home = Path.home().resolve()
        resolved = p.expanduser().resolve()
        if p.is_symlink() or resolved.is_symlink():
            return False
        return resolved == home or resolved.is_relative_to(home)
    except (ValueError, RuntimeError, OSError):
        return False


def cmd_add(remote_name, local_base="MEGA"):
    """Sync a remote folder's CONTENTS into ~/<local_base> (MEGAsync-style:
    choosing /OS fills ~/MEGA with the contents, not ~/MEGA/OS)."""
    name = str(remote_name or "").strip().strip("/")
    if not name or ".." in name.split("/") or len(name) > MAX_STR_LEN:
        log("nama folder remote tidak valid")
        return 1
    base_input = str(local_base or "MEGA").strip()
    if not base_input or ".." in base_input.split("/") or len(base_input) > MAX_STR_LEN:
        log("nama folder lokal tidak valid")
        return 1
    if not ensure_engine():
        return 1
    base = Path(base_input).expanduser()
    if not base.is_absolute():
        base = Path.home() / base
    if base.is_symlink() or not is_safe_user_path(base):
        log("path folder lokal tidak aman atau berupa symlink")
        return 1
    remote = "/" + name

    _, out, _ = sh(SYNC_LIST_ARGS, timeout=10)
    for pair in parse_pairs(out):
        if pair["remote"] == remote and pair["local"] == str(base):
            log(f"{remote} sudah disinkronkan ke {base}")
            return 0
        if pair["local"] == str(base):
            log(f"folder {base} sudah dipakai sync {pair['remote']}; "
                "pakai folder dasar lain")
            return 1

    base.mkdir(parents=True, exist_ok=True)
    rc, _, err = sh(["mega-sync", str(base), remote], timeout=15)
    if rc != 0:
        log(f"gagal menambah sync: {err.strip()}")
        return rc
    refresh_status_now()
    return 0


def refresh_status_now():
    """Re-poll and write status.json so the panel updates immediately after
    a control command instead of waiting for the 5s monitor poll."""
    try:
        m = Monitor()
        m.write_status(m.read_once())
        return 0
    except Exception as exc:  # never break the command on a refresh hiccup
        log(f"gagal refresh status: {exc}")
        return 1


def cmd_remove(path):
    """Remove a sync pair (files stay untouched on both sides)."""
    local = str(path or "").strip()
    if not local:
        log("path folder lokal diperlukan")
        return 1
    p = Path(local).expanduser()
    if p.is_symlink():
        log("path folder berupa symlink; ditolak")
        return 1
    if not ensure_engine():
        return 1
    rc, _, err = sh(["mega-sync", "--delete", local], timeout=15)
    if rc != 0:
        log(f"gagal menghapus sync: {err.strip()}")
        return rc
    refresh_status_now()
    return 0


def cmd_open(path):
    if not path:
        return 1
    p = Path(path).expanduser()
    if p.is_symlink():
        log(f"symlink tidak didukung untuk dibuka: {path}")
        return 1
    if not is_safe_user_path(p) or not p.is_dir():
        log(f"folder tidak ditemukan atau di luar home: {path}")
        return 1
    try:
        subprocess.Popen(
            ["xdg-open", str(p.resolve())],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return 0
    except Exception as exc:
        log(f"gagal membuka folder: {exc}")
        return 1


def cmd_logout():
    """Log out of the active MEGA session."""
    if not ensure_engine():
        return 1
    rc, _, err = sh(["mega-logout"], timeout=10)
    if rc != 0:
        log(f"gagal logout: {err.strip()}")
        return rc
    refresh_status_now()
    return 0


def cmd_login(email=""):
    # The standalone `mega-login` client is non-interactive, and piping
    # commands into `mega-cmd` races the keyboard with its password prompt.
    # omaga-login gives mega-cmd its own pty, feeds `login <email>`, and
    # bridges the real terminal — password and 2FA typing stays hidden.
    try:
        args = ["omaga-login"] + ([email] if email else [])
        subprocess.Popen(
            ["omarchy-launch-terminal"] + args,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
        return 0
    except FileNotFoundError as exc:
        log(f"tidak bisa membuka terminal: {exc}")
        return 127


def main():
    args = sys.argv[1:]
    if not args or args[0] == "monitor":
        Monitor().run()
    elif args[0] == "status":
        return cmd_status()
    elif args[0] == "pause":
        return cmd_pause(args[1] if len(args) > 1 else "")
    elif args[0] == "resume":
        return cmd_resume(args[1] if len(args) > 1 else "")
    elif args[0] == "repair":
        return cmd_repair()
    elif args[0] == "login":
        return cmd_login(args[1] if len(args) > 1 else "")
    elif args[0] == "logout":
        return cmd_logout()
    elif args[0] == "add":
        return cmd_add(args[1] if len(args) > 1 else "",
                       args[2] if len(args) > 2 else "MEGA")
    elif args[0] == "remove":
        return cmd_remove(args[1] if len(args) > 1 else "")
    elif args[0] == "open":
        return cmd_open(args[1] if len(args) > 1 else "")
    elif args[0] == "once":  # one poll — for smoke testing
        m = Monitor()
        print(json.dumps(m.write_status(m.read_once()),
                         ensure_ascii=False, indent=2))
        return 0
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
